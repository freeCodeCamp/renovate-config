{
  "labels": ["renovate"],
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "major": {
    "dependencyDashboardApproval": true
  },
  "rebaseWhen": "conflicted",
  "branchConcurrentLimit": 5,
  "prConcurrentLimit": 5,
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": ["schedule:weekly"],
    "automerge": true,
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "Auto-merge minor/patch/pin/pinDigest/digest updates for non-0.x deps.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "matchCurrentVersion": "!/^v?0/",
      "automerge": true
    },
    {
      "description": "Group all GitHub Actions updates and auto-merge.",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Hold 0.x and v0.x minor/patch updates for dashboard approval, one PR each (semver pre-1.0 instability).",
      "matchCurrentVersion": "/^v?0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": null,
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Hold action digest updates out of the group, with no auto-merge: a branch pin, a bare SHA or a 0.x tag has no stable release to review.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": false,
      "groupName": null
    },
    {
      "description": "Auto-merge action digest updates that follow a 1.x or later version tag.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "matchCurrentVersion": "/^v?[1-9]/",
      "automerge": true,
      "groupName": "GitHub Actions"
    },
    {
      "description": "Hold third-party GitHub Actions major updates for review.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["!actions/**", "!github/**"],
      "automerge": false
    },
    {
      "description": "Generic @types/* bucket. Consumer repos may override for specific framework groups (e.g. @types/react with React).",
      "groupName": "types",
      "matchPackageNames": ["@types/**"]
    },
    {
      "description": "Updates of typescript require explicit dashboard approval.",
      "matchPackageNames": ["typescript"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Major updates of node require explicit dashboard approval.",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Open major updates of GitHub-owned actions without dashboard approval.",
      "groupName": "GitHub-owned actions",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchPackageNames": ["actions/**", "github/**"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Hold major runtime versions in workflows (setup-node, setup-python, setup-go) for dashboard approval, one PR each.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Open major OS image and runner updates for package-approvers review.",
      "groupName": "OS",
      "matchPackageNames": ["ubuntu", "debian", "alpine"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false,
      "automerge": false,
      "reviewers": ["team:package-approvers"]
    },
    {
      "description": "GitHub runner labels have no release timestamp.",
      "matchDatasources": ["github-runners"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Open major package manager updates for package-approvers review.",
      "groupName": "package managers",
      "matchPackageNames": ["pnpm", "npm", "yarn"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false,
      "automerge": false,
      "reviewers": ["team:package-approvers"]
    },
    {
      "description": "Update GitHub Actions on Mondays (UTC), ahead of other updates, to cut code-owner review requests.",
      "matchManagers": ["github-actions"],
      "schedule": ["* * * * 1"],
      "prPriority": 1
    }
  ]
}
